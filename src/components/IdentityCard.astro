---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '@/assets/raidel.png';
import { site } from '@/data/site';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// El puesto actual sale de la experiencia para que no se quede desactualizado.
const [current] = (
  await getCollection('experience', ({ id, data }) => id.startsWith(`${lang}/`) && data.type === 'work' && !data.end)
).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<div>
  <div class="flex items-center gap-4 lg:block">
    <Image
      src={portrait}
      alt=""
      class="size-20 shrink-0 rounded-full object-cover lg:aspect-square lg:size-auto lg:w-full lg:rounded-xl"
      widths={[80, 160, 384, 624]}
      sizes="(min-width: 1024px) 384px, 80px"
      loading="eager"
    />
    <div class="min-w-0 lg:mt-5">
      <p class="font-semibold tracking-tight">{site.fullName}</p>
      <p class="text-muted mt-0.5 text-sm">{t('meta.role')}</p>
    </div>
  </div>

  <dl class="border-border mt-5 border-t text-sm">
    {
      current && (
        <div class="border-border flex items-baseline justify-between gap-4 border-b py-2.5">
          <dt class="text-muted">{t('hero.now')}</dt>
          <dd>
            {current.data.url ? (
              <a href={current.data.url} target="_blank" rel="noopener noreferrer" class="link">
                {current.data.company}
              </a>
            ) : (
              current.data.company
            )}
          </dd>
        </div>
      )
    }
    <div class="border-border flex items-baseline justify-between gap-4 border-b py-2.5">
      <dt class="text-muted">{t('hero.location')}</dt>
      <dd>{site.location[lang]}</dd>
    </div>
  </dl>
</div>
