---
import { siGithub } from 'simple-icons';
import { site } from '@/data/site';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Simple Icons ya no incluye el logo de LinkedIn.
const linkedinPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const socialIcons: Record<string, string> = { GitHub: siGithub.path, LinkedIn: linkedinPath };
---

<section id="contact" class="theme-invert" data-guide="contact">
  <div class="mx-auto max-w-5xl px-5 pt-24 pb-8 sm:pt-32">
    <div data-reveal>
      <h2 class="contact-title">{t('contact.headline')}</h2>
      <p class="text-muted mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">{t('contact.subtitle')}</p>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 80ms">
      <a href={`mailto:${site.email}`} class="btn bg-accent text-accent-fg h-12 px-6 text-base hover:opacity-85">
        {t('contact.write')}
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <button
        type="button"
        class="btn btn-secondary contact-copy h-12 px-4 font-mono"
        aria-label={`${t('contact.copy')}: ${site.email}`}
        title={t('contact.copy')}
        data-copy-email={site.email}
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2"></rect>
          <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
        </svg>
        <span class="contact-copy-labels">
          <span data-copy-label="idle">{site.email}</span>
          <span data-copy-label="copied">{t('contact.copied')}</span>
          <span data-copy-label="error">{t('contact.copyError')}</span>
        </span>
      </button>
      <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
      <noscript><p class="font-mono text-sm">{site.email}</p></noscript>
    </div>

    <div
      class="border-border text-muted mt-20 flex flex-col gap-5 border-t pt-6 text-sm sm:mt-28 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
      style="--reveal-delay: 140ms"
    >
      <p class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <span>
          {site.location[lang]}, <span class="tabular-nums" data-clock data-timezone={site.timeZone} title={t('footer.local')}>--:--</span>
        </span>
        <span>{t('contact.note')}</span>
      </p>

      <ul class="-ml-2 flex flex-wrap items-center gap-1 sm:ml-0 sm:-mr-2">
        {
          site.socials.map(({ label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer" class="contact-link">
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={socialIcons[label]} />
                </svg>
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.cv[lang]} class="contact-link" download>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 4v11M7 11l5 5 5-5M5 20h14"></path>
            </svg>
            {t('hero.cta.cv')}
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-title {
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* Copiar necesita JavaScript; sin él se muestra la dirección como texto. */
  .contact-copy {
    display: none;
  }

  :global(.js) .contact-copy {
    display: inline-flex;
  }

  /* Las tres etiquetas comparten celda para que el botón no cambie de ancho. */
  .contact-copy-labels {
    display: inline-grid;
  }

  .contact-copy-labels > span {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .contact-copy:not([data-state]) [data-copy-label='idle'],
  .contact-copy[data-state='copied'] [data-copy-label='copied'],
  .contact-copy[data-state='error'] [data-copy-label='error'] {
    visibility: visible;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    border-radius: 0.5rem;
    transition: color var(--dur-fast) ease;
  }

  .contact-link:hover {
    color: var(--fg);
  }
</style>

<script>
  let resetTimer: number | undefined;

  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    if (!button || !status) return;

    const label = (state: string) =>
      button.querySelector<HTMLElement>(`[data-copy-label="${state}"]`)?.textContent ?? '';

    button.addEventListener('click', async () => {
      let state = 'copied';
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
      } catch {
        state = 'error';
      }
      button.dataset.state = state;
      status.textContent = label(state);

      clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        delete button.dataset.state;
        status.textContent = '';
      }, 2400);
    });
  }

  document.addEventListener('astro:page-load', initCopyEmail);
</script>
