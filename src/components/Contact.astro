---
import SectionTitle from './SectionTitle.astro';
import { site } from '@/data/site';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Sin una clave real de Web3Forms no mostramos un formulario que fallaría.
const hasForm = site.web3formsKey !== 'YOUR_WEB3FORMS_ACCESS_KEY';
---

<section id="contact" class="border-border border-t">
  <div class="mx-auto max-w-5xl px-5 py-24">
    <div data-reveal>
      <SectionTitle eyebrow="04" title={t('contact.headline')} subtitle={t('contact.subtitle')} />
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.6fr_1fr]">
      {
        hasForm ? (
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="card space-y-5 p-6 sm:p-8"
            data-reveal
            style="--reveal-delay: 60ms"
            data-contact-form
            data-sending={t('contact.sending')}
            data-success={t('contact.success')}
            data-error={t('contact.error')}
          >
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value={`Portfolio: nuevo mensaje (${lang})`} />
            <input type="hidden" name="from_name" value={`${site.fullName} — Portfolio`} />
            {/* Honeypot anti-spam de Web3Forms: los humanos no lo ven. */}
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

            <div class="grid gap-5 sm:grid-cols-2">
              <label class="block">
                <span class="label">{t('contact.name')}</span>
                <input type="text" name="name" required autocomplete="name" class="field" />
              </label>
              <label class="block">
                <span class="label">{t('contact.email')}</span>
                <input type="email" name="email" required autocomplete="email" class="field" />
              </label>
            </div>
            <label class="block">
              <span class="label">{t('contact.message')}</span>
              <textarea name="message" required rows="6" class="field resize-y"></textarea>
            </label>

            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn btn-primary">{t('contact.send')}</button>
              <p role="status" aria-live="polite" class="text-muted text-sm" data-form-status></p>
            </div>
          </form>
        ) : (
          <div
            class="card flex flex-col justify-between gap-8 p-6 sm:p-8"
            data-reveal
            style="--reveal-delay: 60ms"
          >
            <div class="space-y-3">
              <p class="text-faint font-mono text-[10px] uppercase tracking-[0.14em]">Email</p>
              <p class="text-xl font-semibold tracking-tight">{t('contact.cardTitle')}</p>
              <p class="text-muted max-w-md text-sm leading-relaxed">{t('contact.subtitle')}</p>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <a href={`mailto:${site.email}`} class="btn btn-primary">
                {t('contact.write')}
                <span aria-hidden="true">↗</span>
              </a>
              <a href={`mailto:${site.email}`} class="link font-mono text-sm break-all">{site.email}</a>
            </div>
          </div>
        )
      }

      <aside class="card flex flex-col gap-6 p-6 sm:p-8" data-reveal style="--reveal-delay: 140ms">
        <p class="text-muted flex items-center gap-2 text-xs font-medium">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inset-0 rounded-full bg-emerald-500/40"></span>
            <span class="relative size-2 rounded-full bg-emerald-500"></span>
          </span>
          {t('hero.available')}
        </p>

        <div>
          <p class="font-semibold">{t('contact.direct')}</p>
          <p class="text-muted mt-1 text-sm">{t('contact.or')}</p>
          <a href={`mailto:${site.email}`} class="link mt-3 inline-block font-mono text-sm break-all">{site.email}</a>
        </div>

        <div class="border-border mt-auto border-t pt-6">
          <p class="text-muted flex items-center gap-2 text-sm">
            <svg class="text-faint size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            {t('contact.note')}
          </p>
          <ul class="mt-4 flex flex-col gap-2">
            {
              site.socials.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted hover:bg-subtle hover:text-fg -mx-2 flex items-center justify-between rounded-md px-2 py-1.5 text-sm transition-colors"
                  >
                    {label}
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // Envío con fetch para no salir de la página. Sin JS, el formulario se envía de forma normal.
  function initContactForms() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
      const status = form.querySelector<HTMLElement>('[data-form-status]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const { sending, success, error } = form.dataset;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        button.disabled = true;
        status.textContent = sending ?? '';
        status.classList.remove('text-danger');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const result = (await response.json()) as { success?: boolean };
          if (!response.ok || !result.success) throw new Error('Web3Forms rejected the submission');
          status.textContent = success ?? '';
          form.reset();
        } catch {
          status.textContent = error ?? '';
          status.classList.add('text-danger');
        } finally {
          button.disabled = false;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initContactForms);
</script>
