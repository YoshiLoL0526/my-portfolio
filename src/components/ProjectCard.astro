---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localePath, splitEntryId, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { title, description, tags, cover, featured, color } = project.data;
const t = useTranslations(lang);
const href = localePath(lang, `projects/${splitEntryId(project.id).slug}`);
const tint = {
  pink: 'bg-tint-pink',
  blue: 'bg-tint-blue',
  green: 'bg-tint-green',
  yellow: 'bg-tint-yellow',
  purple: 'bg-tint-purple',
}[color];
---

<article class="card group hover:border-border-strong hover:shadow-hover relative flex flex-col overflow-hidden transition">
  <div class:list={['border-border relative aspect-[16/9] overflow-hidden border-b', tint]}>
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          class="size-full object-cover transition duration-500 group-hover:scale-[1.02]"
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      ) : (
        <span class="text-fg/70 absolute inset-0 grid place-items-center p-6 text-center text-2xl font-semibold tracking-tight">
          {title}
        </span>
      )
    }
    {
      featured && (
        <span class="bg-surface/90 border-border absolute top-3 left-3 rounded-full border px-2.5 py-0.5 text-xs font-medium backdrop-blur">
          {t('projects.featured')}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="flex items-center justify-between gap-3 text-base">
      <!-- El enlace cubre toda la tarjeta mediante el pseudo-elemento. -->
      <a href={href} class="after:absolute after:inset-0">{title}</a>
      <span class="text-faint group-hover:text-fg transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </h3>
    <p class="text-muted mt-2 flex-1 text-sm leading-relaxed">{description}</p>
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>
