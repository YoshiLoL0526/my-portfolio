---
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import { localePath, splitEntryId } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  index?: number;
  variant?: 'default' | 'featured';
}

const { project, lang, index, variant = 'default' } = Astro.props;
const { title, description, tags } = project.data;
const href = localePath(lang, `projects/${splitEntryId(project.id).slug}`);
const isFeatured = variant === 'featured';
---

<article
  class:list={[
    'card group relative flex h-full overflow-hidden transition-[border-color,box-shadow] duration-300 hover:border-border-strong hover:shadow-hover has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent',
    isFeatured ? 'flex-col md:grid md:grid-cols-[1.05fr_1fr]' : 'flex-col',
  ]}
>
  <div
    class:list={[
      'border-border relative',
      isFeatured
        ? 'aspect-[16/9] border-b md:aspect-auto md:h-full md:border-r md:border-b-0'
        : 'aspect-[16/9] border-b',
    ]}
  >
    <ProjectCover
      project={project}
      lang={lang}
      index={index}
      variant={isFeatured ? 'featured' : 'card'}
      class="h-full"
    />
  </div>

  <div
    class:list={[
      'flex flex-1 flex-col',
      isFeatured ? 'justify-center p-5 sm:p-6 md:p-8' : 'p-5',
    ]}
  >
    <h3 class:list={['flex items-center justify-between gap-3', isFeatured ? 'text-xl sm:text-2xl' : 'text-base']}>
      <!-- El enlace cubre toda la tarjeta mediante el pseudo-elemento. -->
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
      <span class="text-faint transition group-hover:translate-x-0.5 group-hover:text-fg" aria-hidden="true">→</span>
    </h3>
    <p class:list={['text-muted mt-2 leading-relaxed', isFeatured ? 'text-base' : 'flex-1 text-sm']}>{description}</p>
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>
