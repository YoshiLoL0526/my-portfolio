---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localePath, splitEntryId, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { title, description, tags, cover, featured, color } = project.data;
const t = useTranslations(lang);
const href = localePath(lang, `projects/${splitEntryId(project.id).slug}`);
const bg = { pink: 'bg-pink', blue: 'bg-blue', green: 'bg-green', yellow: 'bg-yellow', purple: 'bg-purple' }[color];
---

<article class="brutal press bg-surface group relative flex flex-col">
  <div class:list={['border-ink relative aspect-video overflow-hidden border-b-3', bg]}>
    {
      cover ? (
        <Image src={cover} alt="" class="size-full object-cover" widths={[400, 800]} sizes="(min-width: 768px) 50vw, 100vw" />
      ) : (
        <span class="font-display on-accent absolute inset-0 grid place-items-center p-4 text-center text-3xl uppercase">
          {title}
        </span>
      )
    }
    {
      featured && (
        <span class="brutal-sm bg-yellow on-accent absolute top-3 right-3 rotate-3 px-2 py-1 font-mono text-xs font-bold uppercase">
          ★ {t('projects.featured')}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-xl">
      <!-- El enlace cubre toda la tarjeta mediante el pseudo-elemento. -->
      <a href={href} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <p class="text-muted mt-2 flex-1">{description}</p>
    <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs">
      {tags.map((tag) => <li class="border-ink border-2 px-2 py-0.5 font-bold">{tag}</li>)}
    </ul>
  </div>
</article>
