---
interface Props {
  title: string;
  subtitle?: string;
  /** h1 en páginas propias, h2 en secciones de la home. */
  as?: 'h1' | 'h2';
}

const { title, subtitle, as: Heading = 'h2' } = Astro.props;
---

<div class="mb-10">
  <Heading class:list={[Heading === 'h1' ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl']}>{title}</Heading>
  {subtitle && <p class="text-muted mt-4 max-w-2xl text-lg">{subtitle}</p>}
</div>
