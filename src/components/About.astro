---
import SectionTitle from './SectionTitle.astro';
import { getCollection } from 'astro:content';
import { site, skills } from '@/data/site';
import { getProjects } from '@/lib/projects';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Las cifras salen del contenido para no tener que actualizarlas a mano.
const projectCount = (await getProjects(lang)).length;
const work = await getCollection('experience', ({ id, data }) => id.startsWith(`${lang}/`) && data.type === 'work');
const firstStart = Math.min(...work.map(({ data }) => data.start.valueOf()));
const years = Math.floor((Date.now() - firstStart) / (365.25 * 24 * 60 * 60 * 1000));

const stats = [
  { value: `${years}+`, label: t('about.stats.years') },
  { value: projectCount, label: t('about.stats.projects') },
  { value: site.spokenLanguages, label: t('about.stats.languages') },
];

const groups = [
  { title: t('skills.agentic'), items: skills.agentic },
  { title: t('skills.ai'), items: skills.ai },
  { title: t('skills.backend'), items: skills.backend },
  { title: t('skills.frontend'), items: skills.frontend },
  { title: t('skills.infra'), items: skills.infra },
];
---

<section id="about" class="border-border border-t" data-guide="about">
  <div class="mx-auto max-w-5xl px-5 py-24">
    <div data-reveal>
      <SectionTitle title={t('about.title')} />
    </div>

    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="text-muted space-y-4 text-lg leading-relaxed" data-reveal style="--reveal-delay: 60ms">
        {t('about.body').replaceAll('{years}', String(years)).split('|').map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="card self-start overflow-hidden" data-reveal style="--reveal-delay: 120ms">
        <p class="border-border text-faint border-b px-5 py-3 font-mono text-[10px] uppercase tracking-[0.14em]">
          {t('about.stats.title')}
        </p>
        <dl>
          {
            stats.map(({ value, label }) => (
              <div class="border-border flex items-baseline justify-between gap-4 border-b px-5 py-4 last:border-b-0">
                <dt class="text-muted text-sm">{label}</dt>
                <dd class="text-2xl font-semibold tracking-tight tabular-nums">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="mt-20" data-reveal data-guide="skills">
      <h3 class="mb-6 text-lg">{t('skills.more')}</h3>
      <dl class="border-border border-b">
        {
          groups.map(({ title, items }) => (
            <div class="border-border grid gap-1 border-t py-4 sm:grid-cols-[16rem_1fr] sm:gap-6">
              <dt class="text-muted text-sm sm:text-base">{title}</dt>
              <dd>{items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
