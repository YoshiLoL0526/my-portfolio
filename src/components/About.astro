---
import SectionTitle from './SectionTitle.astro';
import { site, skills } from '@/data/site';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: `${site.stats.years}+`, label: t('about.stats.years') },
  { value: site.stats.projects, label: t('about.stats.projects') },
  { value: site.stats.languages, label: t('about.stats.languages') },
];

const groups = [
  { title: t('skills.languages'), items: skills.languages },
  { title: t('skills.backend'), items: skills.backend },
  { title: t('skills.frontend'), items: skills.frontend },
  { title: t('skills.ai'), items: skills.ai },
  { title: t('skills.data'), items: skills.data },
  { title: t('skills.infra'), items: skills.infra },
  // La ingeniería agéntica ocupa una fila completa para darle protagonismo.
  { title: t('skills.agentic'), items: skills.agentic, wide: true },
];
---

<section id="about" class="border-border border-t">
  <div class="mx-auto max-w-5xl px-5 py-24">
    <div data-reveal>
      <SectionTitle eyebrow="01" title={t('about.title')} />
    </div>

    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div class="text-muted space-y-4 text-lg leading-relaxed" data-reveal style="--reveal-delay: 60ms">
        {t('about.body').split('|').map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="card self-start overflow-hidden" data-reveal style="--reveal-delay: 120ms">
        <p class="border-border text-faint flex items-center justify-between border-b px-5 py-3 font-mono text-[10px] uppercase tracking-[0.14em]">
          <span>{t('about.stats.title')}</span>
          <span aria-hidden="true">01—03</span>
        </p>
        <dl>
          {
            stats.map(({ value, label }) => (
              <div class="border-border flex items-baseline justify-between gap-4 border-b px-5 py-4 last:border-b-0">
                <dt class="text-muted text-sm">{label}</dt>
                <dd class="text-2xl font-semibold tracking-tight tabular-nums">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <h3 class="mt-20 mb-6 text-lg" data-reveal>{t('skills.title')}</h3>
    <div class="grid gap-4 md:grid-cols-3">
      {
        groups.map(({ title, items, wide }, index) => (
          <div
            class:list={['card p-5', wide && 'md:col-span-3']}
            data-reveal
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <p class="text-faint mb-4 font-mono text-xs tracking-wider uppercase">{title}</p>
            <ul class="flex flex-wrap gap-2">
              {items.map((item) => (
                <li class="border-border rounded-md border px-2.5 py-1 text-sm">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
