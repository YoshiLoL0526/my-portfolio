---
import { techRows } from '@/data/tech';
import { useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Cuatro copias para que el bucle cubra también pantallas muy anchas.
const copies = 4;
const durations = ['60s', '72s'];
const icons = techRows.flat().map(({ icon }) => icon);

// Luminancia aproximada: los logos casi negros o casi blancos usarían un color
// invisible al pasar el cursor, así que en esos casos heredan el color del texto.
function luminance(hex: string) {
  const [r, g, b] = [0, 2, 4].map((start) => parseInt(hex.slice(start, start + 2), 16) / 255) as [number, number, number];
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

function brandVars(hex: string) {
  const value = luminance(hex);
  const onLight = value > 0.65 ? 'var(--fg)' : `#${hex}`;
  const onDark = value < 0.25 ? 'var(--fg)' : `#${hex}`;
  return `--on-light: ${onLight}; --on-dark: ${onDark}`;
}
---

<section class="border-border border-t py-14" aria-labelledby="stack-title" data-marquee data-guide="stack">
  <svg class="hidden" aria-hidden="true">
    {
      icons.map(({ slug, path }) => (
        <symbol id={`tech-${slug}`} viewBox="0 0 24 24">
          <path d={path} />
        </symbol>
      ))
    }
  </svg>

  <div class="mx-auto mb-8 flex max-w-5xl items-center justify-between gap-4 px-5">
    <h2 id="stack-title" class="text-lg">{t('skills.title')}</h2>
    <button type="button" class="icon-btn tech-toggle" aria-pressed="false" aria-label={t('stack.pause')} title={t('stack.pause')} data-marquee-toggle>
      <svg class="tech-toggle-pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="6" y="4.5" width="4" height="15" rx="1"></rect>
        <rect x="14" y="4.5" width="4" height="15" rx="1"></rect>
      </svg>
      <svg class="tech-toggle-play size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5.2v13.6a1 1 0 0 0 1.53.85l10.9-6.8a1 1 0 0 0 0-1.7L9.53 4.35A1 1 0 0 0 8 5.2Z"></path>
      </svg>
    </button>
  </div>

  <div class="flex flex-col gap-7">
    {
      techRows.map((items, rowIndex) => (
        <div class="tech-row">
          <div class:list={['tech-track', rowIndex % 2 === 1 && 'tech-track-reverse']} style={`--duration: ${durations[rowIndex]}`}>
            {Array.from({ length: copies }, (_, copy) => (
              <ul class="tech-group" aria-hidden={copy > 0 ? 'true' : undefined} data-clone={copy > 0 ? '' : undefined}>
                {items.map(({ name, icon }) => (
                  <li class="tech-item" style={brandVars(icon.hex)}>
                    <svg class="tech-icon" aria-hidden="true">
                      <use href={`#tech-${icon.slug}`} />
                    </svg>
                    <span>{name}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tech-row {
    --gap: 2.75rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
  }

  .tech-track {
    display: flex;
    width: max-content;
    animation: tech-slide var(--duration) linear infinite;
    will-change: transform;
  }

  .tech-track-reverse {
    animation-direction: reverse;
  }

  .tech-group {
    display: flex;
    flex-shrink: 0;
    gap: var(--gap);
    padding-right: var(--gap);
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  .tech-icon {
    width: 1.375rem;
    height: 1.375rem;
    flex-shrink: 0;
    fill: currentColor;
    transition: fill var(--dur-fast) ease;
  }

  [data-marquee][data-paused='true'] .tech-track {
    animation-play-state: paused;
  }

  .tech-toggle {
    display: none;
  }

  .tech-toggle-play {
    display: none;
  }

  .tech-toggle[aria-pressed='true'] .tech-toggle-pause {
    display: none;
  }

  .tech-toggle[aria-pressed='true'] .tech-toggle-play {
    display: block;
  }

  @media (hover: hover) {
    .tech-row:hover .tech-track {
      animation-play-state: paused;
    }

    .tech-item:hover {
      color: var(--fg);
    }

    .tech-item:hover .tech-icon {
      fill: var(--on-light);
    }

    :global([data-theme='dark']) .tech-item:hover .tech-icon {
      fill: var(--on-dark);
    }
  }

  @media (max-width: 640px) {
    .tech-row {
      --gap: 2rem;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
      mask-image: linear-gradient(to right, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tech-toggle {
      display: grid;
    }
  }

  /* Sin movimiento: lista estática completa, sin copias ni logos recortados. */
  @media (prefers-reduced-motion: reduce), print {
    .tech-row {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .tech-track {
      width: auto;
      animation: none;
    }

    .tech-group {
      flex-wrap: wrap;
      flex-shrink: 1;
      gap: 1rem 2rem;
      max-width: 64rem;
      margin-inline: auto;
      padding-inline: 1.25rem;
    }

    .tech-group[data-clone] {
      display: none;
    }
  }

  @keyframes tech-slide {
    to {
      transform: translateX(-25%);
    }
  }
</style>

<script>
  function initMarquee() {
    const marquee = document.querySelector<HTMLElement>('[data-marquee]');
    const toggle = marquee?.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
    if (!marquee || !toggle) return;

    toggle.addEventListener('click', () => {
      const paused = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(paused));
      marquee.dataset.paused = String(paused);
    });
  }

  document.addEventListener('astro:page-load', initMarquee);
</script>
