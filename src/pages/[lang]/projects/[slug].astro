---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatMonth, localePath, splitEntryId, useTranslations } from '@/i18n/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    const { lang, slug } = splitEntryId(project.id);
    return { params: { lang, slug }, props: { project } };
  });
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { lang } = splitEntryId(project.id);
const t = useTranslations(lang);
const { title, description, tags, cover, repo, demo, date, color } = project.data;
const { Content } = await render(project);
const tint = {
  pink: 'bg-tint-pink',
  blue: 'bg-tint-blue',
  green: 'bg-tint-green',
  yellow: 'bg-tint-yellow',
  purple: 'bg-tint-purple',
}[color];
---

<BaseLayout lang={lang} title={title} description={description}>
  <article class="mx-auto max-w-3xl px-5 pt-12 pb-24">
    <a href={localePath(lang, 'projects')} class="text-muted hover:text-fg inline-flex items-center gap-1.5 text-sm transition-colors">
      <span aria-hidden="true">←</span> {t('projects.back')}
    </a>

    <header class="mt-10">
      <p class="text-muted font-mono text-xs">{formatMonth(date, lang)}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{title}</h1>
      <p class="text-muted mt-5 text-lg leading-relaxed">{description}</p>
      <ul class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
      {
        (demo || repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {demo && <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t('projects.demo')} <span aria-hidden="true">↗</span></a>}
            {repo && <a href={repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{t('projects.repo')} <span aria-hidden="true">↗</span></a>}
          </div>
        )
      }
    </header>

    <div class:list={['border-border mt-12 aspect-video overflow-hidden rounded-xl border', tint]}>
      {
        cover ? (
          <Image src={cover} alt="" class="size-full object-cover" widths={[800, 1600]} sizes="(min-width: 768px) 768px, 100vw" />
        ) : (
          <span class="text-fg/70 grid size-full place-items-center p-6 text-center text-3xl font-semibold tracking-tight sm:text-4xl">
            {title}
          </span>
        )
      }
    </div>

    <div class="prose-content text-muted mt-12 text-[1.05rem]">
      <Content />
    </div>
  </article>
</BaseLayout>
