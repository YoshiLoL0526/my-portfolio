---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import { getProjects } from '@/lib/projects';
import { formatMonth, localePath, splitEntryId, useTranslations } from '@/i18n/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    const { lang, slug } = splitEntryId(project.id);
    return { params: { lang, slug }, props: { project } };
  });
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { lang } = splitEntryId(project.id);
const t = useTranslations(lang);
const { title, description, tags, repo, demo, date } = project.data;
const { Content } = await render(project);
// Mismo número que la tarjeta del listado, para que la portada mantenga continuidad.
const ordered = await getProjects(lang);
const index = ordered.findIndex((entry) => entry.id === project.id) + 1;
---

<BaseLayout lang={lang} title={title} description={description}>
  <article class="mx-auto max-w-3xl px-5 pt-12 pb-24">
    <a href={localePath(lang, 'projects')} class="text-muted hover:text-fg inline-flex items-center gap-1.5 text-sm transition-colors">
      <span aria-hidden="true">←</span> {t('projects.back')}
    </a>

    <header class="mt-10">
      <p class="text-muted font-mono text-xs">{formatMonth(date, lang)}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{title}</h1>
      <p class="text-muted mt-5 text-lg leading-relaxed">{description}</p>
      <ul class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
      {
        (demo || repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {demo && <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t('projects.demo')} <span aria-hidden="true">↗</span></a>}
            {repo && <a href={repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{t('projects.repo')} <span aria-hidden="true">↗</span></a>}
          </div>
        )
      }
    </header>

    <!-- Sin captura, la portada generada es una franja: un bloque 16:9 vacío pesa demasiado. -->
    <div
      class:list={[
        'border-border mt-12 overflow-hidden rounded-xl border',
        project.data.cover ? 'aspect-video' : 'aspect-[3/1]',
      ]}
    >
      <ProjectCover project={project} lang={lang} index={index} variant="detail" class="h-full" />
    </div>

    <div class="prose-content text-muted mt-12 text-[1.05rem]">
      <Content />
    </div>

    <div class="border-border mt-16 border-t pt-6">
      <a href={localePath(lang, 'projects')} class="text-muted hover:text-fg inline-flex items-center gap-1.5 text-sm transition-colors">
        <span aria-hidden="true">←</span> {t('projects.back')}
      </a>
    </div>
  </article>
</BaseLayout>
