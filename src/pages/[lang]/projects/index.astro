---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projectCategories } from '@/data/site';
import { countTags, getProjects } from '@/lib/projects';
import { langs, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const tags = countTags(projects);
// Con JS solo se ven las tecnologías más usadas; el resto aparece con "Ver todas".
const VISIBLE_TAGS = 12;
const hiddenTags = Math.max(0, tags.length - VISIBLE_TAGS);
// Solo se ofrecen los tipos que tienen algún proyecto.
const categories = projectCategories.filter((c) => projects.some((p) => p.data.category === c));

// Texto en el que busca el filtro: minúsculas y sin tildes, igual que normaliza el script.
// Las tecnologías se añaden también sin puntuación para que "nodejs" encuentre "Node.js".
const searchText = ({ title, description, tags, category }: (typeof projects)[number]['data']) =>
  [title, description, t(`category.${category}`), ...tags, ...tags.map((tag) => tag.replace(/[^\p{L}\p{N}]/gu, ''))]
    .join(' ')
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase();

const chip =
  'border-border bg-surface text-muted hover:border-border-strong hover:text-fg has-checked:border-fg has-checked:bg-fg has-checked:text-bg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent inline-flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1 text-sm transition-colors select-none';
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.page.subtitle')}>
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-24" data-guide="projectsPage">
    <SectionTitle as="h1" title={t('projects.title')} subtitle={t('projects.page.subtitle')} />

    <form class="card space-y-6 p-5 sm:p-6" data-project-filters role="search">
      <div class="grid gap-4 sm:grid-cols-[1fr_auto]">
        <label class="block">
          <span class="label">{t('filters.search')}</span>
          <input
            type="search"
            name="q"
            placeholder={t('filters.search.placeholder')}
            autocomplete="off"
            class="field"
          />
        </label>
        <label class="block">
          <span class="label">{t('filters.sort')}</span>
          <select name="sort" class="field cursor-pointer sm:w-56">
            <option value="newest">{t('filters.sort.newest')}</option>
            <option value="oldest">{t('filters.sort.oldest')}</option>
            <option value="title">{t('filters.sort.title')}</option>
          </select>
        </label>
      </div>

      <fieldset>
        <legend class="label mb-3">{t('filters.category')}</legend>
        <div class="flex flex-wrap gap-2">
          <label class={chip}>
            <input type="radio" name="category" value="" checked class="sr-only" />
            {t('filters.all')}
          </label>
          {
            categories.map((category) => (
              <label class={chip}>
                <input type="radio" name="category" value={category} class="sr-only" />
                {t(`category.${category}`)}
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="label mb-3">{t('filters.tech')}</legend>
        <div class="flex flex-wrap gap-3" data-tech-list>
          {
            tags.map(([tag, count], index) => (
              <label class={chip} data-extra={index >= VISIBLE_TAGS ? '' : undefined}>
                <input type="checkbox" name="tech" value={tag} class="sr-only" />
                {tag}
                <span class="font-mono text-xs opacity-60">{count}</span>
              </label>
            ))
          }
          {
            hiddenTags > 0 && (
              <button
                type="button"
                class="tech-toggle text-muted hover:text-fg rounded-full px-3 py-1 text-sm underline-offset-4 transition-colors hover:underline"
                aria-expanded="false"
                data-tech-toggle
              >
                <span data-when="collapsed">{t('filters.more')} (+{hiddenTags})</span>
                <span data-when="expanded">{t('filters.less')}</span>
              </button>
            )
          }
        </div>
      </fieldset>

      <div class="border-border flex flex-wrap items-center justify-between gap-4 border-t pt-5">
        <p class="text-muted text-sm" aria-live="polite">
          <span class="text-fg font-medium" data-result-count>{projects.length}</span> / {projects.length} {t('filters.results')}
        </p>
        <button type="reset" class="btn btn-ghost h-9">{t('filters.clear')}</button>
      </div>
    </form>

    <ul class="mt-10 grid gap-6 md:grid-cols-2" data-project-list>
      {
        projects.map((project, index) => (
          <li
            data-search={searchText(project.data)}
            data-title={project.data.title}
            data-tags={JSON.stringify(project.data.tags)}
            data-category={project.data.category}
            data-date={project.data.date.valueOf()}
            class="grid"
          >
            <ProjectCard project={project} lang={lang} index={index + 1} />
          </li>
        ))
      }
    </ul>

    <div class="border-border mt-10 hidden rounded-xl border border-dashed p-12 text-center" data-empty-state>
      <p class="font-semibold">{t('filters.empty.title')}</p>
      <p class="text-muted mt-1 text-sm">{t('filters.empty.body')}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Sin JS se muestran todas las tecnologías y no hace falta el botón. */
  .tech-toggle {
    display: none;
  }

  :global(.js) .tech-toggle {
    display: inline-flex;
  }

  /* Las tecnologías extra seleccionadas siguen visibles aunque la lista esté plegada. */
  :global(.js) [data-tech-list]:not([data-expanded]) [data-extra]:not(:has(:checked)) {
    display: none;
  }

  [data-tech-list]:not([data-expanded]) [data-when='expanded'],
  [data-tech-list][data-expanded] [data-when='collapsed'] {
    display: none;
  }
</style>

<script>
  function initProjects() {
    const form = document.querySelector<HTMLFormElement>('[data-project-filters]')!;
    const list = document.querySelector<HTMLUListElement>('[data-project-list]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty-state]')!;
    const count = document.querySelector<HTMLElement>('[data-result-count]')!;
    if (!form || !list || !empty || !count) return;

    const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')].map((el) => ({
      el,
      search: el.dataset.search ?? '',
      title: el.dataset.title ?? '',
      tags: JSON.parse(el.dataset.tags ?? '[]') as string[],
      category: el.dataset.category ?? '',
      date: Number(el.dataset.date),
    }));
    // Orden original (destacados primero), que también es el de "más recientes".
    const initialOrder = [...items];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const normalize = (value: string) =>
      value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

    function readState() {
      const data = new FormData(form);
      return {
        q: String(data.get('q') ?? ''),
        category: String(data.get('category') ?? ''),
        tech: data.getAll('tech').map(String),
        sort: String(data.get('sort') ?? 'newest'),
      };
    }

    function apply({ animate = true }: { animate?: boolean } = {}) {
      const { q, category, tech, sort } = readState();
      const words = normalize(q).split(/\s+/).filter(Boolean);

      const before = new Map<HTMLLIElement, DOMRect>();
      if (animate && !reduceMotion.matches) {
        for (const item of items) {
          if (!item.el.hidden) before.set(item.el, item.el.getBoundingClientRect());
        }
      }

      const sorted =
        sort === 'oldest'
          ? [...items].sort((a, b) => a.date - b.date)
          : sort === 'title'
            ? [...items].sort((a, b) => a.title.localeCompare(b.title))
            : initialOrder;

      let visible = 0;
      for (const item of sorted) {
        const matches =
          words.every((word) => item.search.includes(word)) &&
          (!category || item.category === category) &&
          tech.every((tag) => item.tags.includes(tag));
        item.el.hidden = !matches;
        if (matches) visible++;
        list.append(item.el);
      }

      count.textContent = String(visible);
      empty.classList.toggle('hidden', visible > 0);
      syncUrl({ q, category, tech, sort });

      if (!animate || reduceMotion.matches) return;

      // FLIP: los elementos que siguen visibles se deslizan desde su posición anterior.
      for (const [el, rect] of before) {
        if (el.hidden) continue;
        const next = el.getBoundingClientRect();
        const dx = rect.left - next.left;
        const dy = rect.top - next.top;
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) continue;
        el.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
          { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
      }
    }

    // Los filtros se guardan en la URL para poder compartir o volver a una búsqueda.
    function syncUrl({ q, category, tech, sort }: ReturnType<typeof readState>) {
      const params = new URLSearchParams();
      if (q) params.set('q', q);
      if (category) params.set('category', category);
      if (tech.length) params.set('tech', tech.join(','));
      if (sort !== 'newest') params.set('sort', sort);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    function restoreFromUrl() {
      const params = new URLSearchParams(location.search);
      form.q.value = params.get('q') ?? '';
      const sort = params.get('sort');
      if (sort && [...form.sort.options].some((o: HTMLOptionElement) => o.value === sort)) form.sort.value = sort;
      const category = params.get('category') ?? '';
      form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
        input.checked = input.value === category;
      });
      const tech = new Set(params.get('tech')?.split(',') ?? []);
      form.querySelectorAll<HTMLInputElement>('input[name="tech"]').forEach((input) => {
        input.checked = tech.has(input.value);
      });
    }

    const techList = form.querySelector<HTMLElement>('[data-tech-list]');
    const techToggle = form.querySelector<HTMLButtonElement>('[data-tech-toggle]');
    techToggle?.addEventListener('click', () => {
      const expanded = techList?.toggleAttribute('data-expanded') ?? false;
      techToggle.setAttribute('aria-expanded', String(expanded));
    });

    form.addEventListener('input', () => apply());
    form.addEventListener('submit', (event) => event.preventDefault());
    // "reset" dispara antes de restablecer los valores, así que se aplica en el siguiente tick.
    form.addEventListener('reset', () => setTimeout(() => apply()));

    restoreFromUrl();
    apply({ animate: false });
  }

  document.addEventListener('astro:page-load', initProjects);
</script>
