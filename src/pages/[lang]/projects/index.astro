---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projectCategories } from '@/data/site';
import { countTags, getProjects } from '@/lib/projects';
import { langs, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects(lang);
const tags = countTags(projects);
// Solo se ofrecen los tipos que tienen algún proyecto.
const categories = projectCategories.filter((c) => projects.some((p) => p.data.category === c));

// Texto en el que busca el filtro: minúsculas y sin tildes, igual que normaliza el script.
// Las tecnologías se añaden también sin puntuación para que "nodejs" encuentre "Node.js".
const searchText = ({ title, description, tags, category }: (typeof projects)[number]['data']) =>
  [title, description, t(`category.${category}`), ...tags, ...tags.map((tag) => tag.replace(/[^\p{L}\p{N}]/gu, ''))]
    .join(' ')
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase();

const chip =
  'brutal-sm press has-checked:bg-yellow has-checked:text-on-accent has-focus-visible:outline-3 has-focus-visible:outline-offset-2 has-focus-visible:outline-ink bg-surface inline-flex cursor-pointer items-center gap-2 px-3 py-1.5 font-bold select-none';
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.page.subtitle')}>
  <section class="mx-auto max-w-6xl px-4 pt-14 pb-10">
    <SectionTitle as="h1" title={t('projects.title')} subtitle={t('projects.page.subtitle')} color="blue" />

    <form class="brutal bg-surface space-y-6 p-5 sm:p-6" data-project-filters role="search">
      <div class="grid gap-4 sm:grid-cols-[1fr_auto]">
        <label class="block">
          <span class="mb-2 block font-bold uppercase">{t('filters.search')}</span>
          <input
            type="search"
            name="q"
            placeholder={t('filters.search.placeholder')}
            autocomplete="off"
            class="brutal-sm bg-paper focus:bg-surface focus:shadow-brutal w-full px-4 py-3 font-medium outline-none"
          />
        </label>
        <label class="block">
          <span class="mb-2 block font-bold uppercase">{t('filters.sort')}</span>
          <select name="sort" class="brutal-sm bg-paper w-full cursor-pointer px-4 py-3 font-bold sm:w-56">
            <option value="newest">{t('filters.sort.newest')}</option>
            <option value="oldest">{t('filters.sort.oldest')}</option>
            <option value="title">{t('filters.sort.title')}</option>
          </select>
        </label>
      </div>

      <fieldset>
        <legend class="mb-3 font-bold uppercase">{t('filters.category')}</legend>
        <div class="flex flex-wrap gap-3">
          <label class={chip}>
            <input type="radio" name="category" value="" checked class="sr-only" />
            {t('filters.all')}
          </label>
          {
            categories.map((category) => (
              <label class={chip}>
                <input type="radio" name="category" value={category} class="sr-only" />
                {t(`category.${category}`)}
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-3 font-bold uppercase">{t('filters.tech')}</legend>
        <div class="flex flex-wrap gap-3">
          {
            tags.map(([tag, count]) => (
              <label class={chip}>
                <input type="checkbox" name="tech" value={tag} class="sr-only" />
                {tag}
                <span class="font-mono text-xs opacity-70">{count}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="border-ink flex flex-wrap items-center justify-between gap-4 border-t-3 pt-5">
        <p class="font-mono font-bold" aria-live="polite">
          <span data-result-count>{projects.length}</span> / {projects.length} {t('filters.results')}
        </p>
        <button type="reset" class="btn bg-pink px-4 py-2 text-sm">{t('filters.clear')} ✕</button>
      </div>
    </form>

    <ul class="mt-12 grid gap-8 md:grid-cols-2" data-project-list>
      {
        projects.map((project) => (
          <li
            data-search={searchText(project.data)}
            data-title={project.data.title}
            data-tags={JSON.stringify(project.data.tags)}
            data-category={project.data.category}
            data-date={project.data.date.valueOf()}
            class="grid"
          >
            <ProjectCard project={project} lang={lang} />
          </li>
        ))
      }
    </ul>

    <div class="brutal bg-yellow on-accent mt-12 hidden p-8 text-center" data-empty-state>
      <p class="font-display text-3xl uppercase">{t('filters.empty.title')}</p>
      <p class="mt-2 text-lg">{t('filters.empty.body')}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-project-filters]')!;
  const list = document.querySelector<HTMLUListElement>('[data-project-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty-state]')!;
  const count = document.querySelector<HTMLElement>('[data-result-count]')!;

  const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')].map((el) => ({
    el,
    search: el.dataset.search ?? '',
    title: el.dataset.title ?? '',
    tags: JSON.parse(el.dataset.tags ?? '[]') as string[],
    category: el.dataset.category ?? '',
    date: Number(el.dataset.date),
  }));
  // Orden original (destacados primero), que también es el de "más recientes".
  const initialOrder = [...items];

  const normalize = (value: string) =>
    value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

  function readState() {
    const data = new FormData(form);
    return {
      q: String(data.get('q') ?? ''),
      category: String(data.get('category') ?? ''),
      tech: data.getAll('tech').map(String),
      sort: String(data.get('sort') ?? 'newest'),
    };
  }

  function apply() {
    const { q, category, tech, sort } = readState();
    const words = normalize(q).split(/\s+/).filter(Boolean);

    const sorted =
      sort === 'oldest'
        ? [...items].sort((a, b) => a.date - b.date)
        : sort === 'title'
          ? [...items].sort((a, b) => a.title.localeCompare(b.title))
          : initialOrder;

    let visible = 0;
    for (const item of sorted) {
      const matches =
        words.every((word) => item.search.includes(word)) &&
        (!category || item.category === category) &&
        tech.every((tag) => item.tags.includes(tag));
      item.el.hidden = !matches;
      if (matches) visible++;
      list.append(item.el);
    }

    count.textContent = String(visible);
    empty.classList.toggle('hidden', visible > 0);
    syncUrl({ q, category, tech, sort });
  }

  // Los filtros se guardan en la URL para poder compartir o volver a una búsqueda.
  function syncUrl({ q, category, tech, sort }: ReturnType<typeof readState>) {
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    if (category) params.set('category', category);
    if (tech.length) params.set('tech', tech.join(','));
    if (sort !== 'newest') params.set('sort', sort);
    const query = params.toString();
    history.replaceState(null, '', query ? `?${query}` : location.pathname);
  }

  function restoreFromUrl() {
    const params = new URLSearchParams(location.search);
    form.q.value = params.get('q') ?? '';
    const sort = params.get('sort');
    if (sort && [...form.sort.options].some((o: HTMLOptionElement) => o.value === sort)) form.sort.value = sort;
    const category = params.get('category') ?? '';
    form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
      input.checked = input.value === category;
    });
    const tech = new Set(params.get('tech')?.split(',') ?? []);
    form.querySelectorAll<HTMLInputElement>('input[name="tech"]').forEach((input) => {
      input.checked = tech.has(input.value);
    });
  }

  form.addEventListener('input', apply);
  form.addEventListener('submit', (event) => event.preventDefault());
  // "reset" dispara antes de restablecer los valores, así que se aplica en el siguiente tick.
  form.addEventListener('reset', () => setTimeout(apply));

  restoreFromUrl();
  apply();
</script>
