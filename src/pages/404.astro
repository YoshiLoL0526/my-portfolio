---
// Apache sirve esta página para cualquier ruta inexistente (ver public/.htaccess),
// así que no sabemos el idioma en build: mostramos ambos.
import '@/styles/global.css';
import Logo from '@/components/Logo.astro';
import { site } from '@/data/site';
import { ui } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — {site.fullName}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {}
    </script>
  </head>
  <body class="grid min-h-dvh place-items-center p-5">
    <div class="grain" aria-hidden="true"></div>
    <main class="relative w-full max-w-md text-center">
      <span class="bg-fg text-bg mx-auto mb-6 grid size-10 place-items-center rounded-lg" aria-hidden="true">
        <Logo class="size-5" />
      </span>
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-4 text-3xl sm:text-4xl">{ui.es['404.title']}</h1>
      <p class="text-muted mt-3">{ui.es['404.body']}</p>
      <p lang="en" class="text-faint mt-2 text-sm">{ui.en['404.title']} — {ui.en['404.body']}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={localePath('es')} class="btn btn-primary">{ui.es['404.back']}</a>
        <a href={localePath('en')} lang="en" class="btn btn-secondary">{ui.en['404.back']}</a>
      </div>
    </main>
  </body>
</html>
